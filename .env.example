# ── LLM Providers ──────────────────────────────────────────────────────────────
# Get free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Fallback (optional but recommended): https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here

# Primary model (Groq free tier)
LLM_MODEL=llama-3.1-70b-versatile
LLM_PROVIDER=groq

# ── Vector Database ─────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=financebench
# Only needed if using Qdrant Cloud instead of local Docker
QDRANT_API_KEY=

# ── Redis Semantic Cache ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
SEMANTIC_CACHE_THRESHOLD=0.92   # cosine similarity threshold for cache hit
CACHE_TTL_SECONDS=3600

# ── Embeddings ──────────────────────────────────────────────────────────────────
# Base model (swapped for fine-tuned version after Week 6)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Set to path of fine-tuned model after training:
# EMBEDDING_MODEL=./models/financebench-finetuned

# ── Observability ──────────────────────────────────────────────────────────────
# Get free keys at: https://langfuse.com
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Evaluation ─────────────────────────────────────────────────────────────────
# DeepEval uses OpenAI as judge model by default
DEEPEVAL_API_KEY=your_openai_api_key_here
# Thresholds — CI fails if scores drop below these
FAITHFULNESS_THRESHOLD=0.75
CONTEXTUAL_PRECISION_THRESHOLD=0.70
ANSWER_RELEVANCY_THRESHOLD=0.75

# ── Security ────────────────────────────────────────────────────────────────────
# Rate limiting
RATE_LIMIT_PER_MINUTE=20
MAX_QUERY_LENGTH=2000

# ── App Config ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development   # development | production
LOG_LEVEL=INFO
TOP_K_RETRIEVE=20         # candidates before reranking
TOP_K_RERANK=5            # final chunks sent to LLM
ENABLE_HYBRID_RETRIEVAL=true
ENABLE_HYDE=true
ENABLE_QUERY_DECOMPOSITION=true
